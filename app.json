{
  "expo": {
    "name": "Zād al-Hudā",
    "slug": "Zad-al-Huda",
    "version": "1.7.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "zad-al-huda",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zadalhuda.app"
    },
    "android": {
      "package": "com.zadalhuda.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/zad-al-huda.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/zad-al-huda.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#232323",
          "image": "./assets/images/zad-al-huda.png",
          "dark": {
            "image": "./assets/images/zad-al-huda.png",
            "backgroundColor": "#000000"
          },
          "imageWidth": 200
        }
      ],
      "expo-localization",
      "expo-audio",
      "expo-font",
      "expo-asset",
      "expo-status-bar"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fdee6ad8-b217-4e48-b239-42f11ea68d2d"
      }
    }
  }
}
